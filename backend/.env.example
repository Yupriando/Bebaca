# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi_anon_atau_publishable_key
# RAHASIA! Jangan pernah dimasukkan ke aplikasi Flutter / di-commit ke git
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_atau_secret_key

PORT=3000
# Pisahkan dengan koma kalau lebih dari satu. Aplikasi mobile tidak terpengaruh CORS.
CORS_ORIGIN=*
# Set true kalau di-deploy di belakang proxy (Render, Railway, dsb)
TRUST_PROXY=false

# Izinkan tombol Premium simulasi (tanpa bayar) saat NODE_ENV=production / di Vercel.
# Hanya untuk masa uji coba; MATIKAN (hapus / false) sebelum aplikasi dirilis.
ALLOW_PREMIUM_SIMULATION=false
